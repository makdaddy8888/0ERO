{
  "name": "0ero",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first Australian personal tax prep helper (myTax review engine)",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:clean": "for p in 3000 3001 3002 3003 3004 3005 3006 3007 3008 3009 3010; do lsof -ti :$p 2>/dev/null | xargs kill -9 2>/dev/null; done; rm -rf .next node_modules/.cache; next dev -H 127.0.0.1 -p 3000",
    "dev:stable": "npm run build && npm run start",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "privacy:audit": "bash scripts/privacy-audit.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "setup": "bash scripts/install.sh",
    "security:check": "npm audit --audit-level=high && npm run privacy:audit && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "australian-tax",
    "mytax",
    "ato",
    "local-first",
    "privacy",
    "no-llm",
    "self-hosted",
    "personal-finance",
    "tax-checklist",
    "working-from-home",
    "capital-gains"
  ]
}
